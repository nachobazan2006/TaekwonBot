@page "/mensajes"
@attribute [Authorize]
@using BlazorTaekwondo.Models
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorTaekwondo.Services.MensajeService MensajeService

<div class="mensajes-page">
    <div class="mensajes-grid">
        <aside class="message-side-card ui-reveal" style="--reveal-delay: 0ms;">
            <header class="message-card-header">
                <h1>@(modoEdicion ? "Editar contacto" : "Nuevo contacto")</h1>
                <p>Gestiona los contactos para mensajes automaticos</p>
            </header>

            <div class="message-field">
                <label for="contacto-numero">Numero</label>
                <div class="message-input-shell">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M8 5c.5 4.8 3.2 8.5 8 11l2.2-2.2a1.2 1.2 0 0 1 1.2-.3l2.4.8v4.4c0 .7-.5 1.3-1.2 1.3C10.8 20 4 13.2 4 3.4 4 2.7 4.6 2 5.3 2h4.4l.8 2.4c.1.4 0 .8-.3 1.2L8 5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    </svg>
                    <input id="contacto-numero" @bind="contactoForm.Numero" placeholder="Ej: 3511234567" />
                </div>
            </div>

            <div class="message-field">
                <label for="contacto-estado">Estado</label>
                <div class="message-input-shell select-shell">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    </svg>
                    <select id="contacto-estado" @bind="contactoForm.Estado">
                        <option value="">Seleccionar</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Contactado">Contactado</option>
                        <option value="Asistio">Asistio</option>
                        <option value="No asistio">No asistio</option>
                    </select>
                </div>
            </div>

            <div class="message-field">
                <label for="contacto-fecha">Fecha de contacto</label>
                <div class="message-input-shell">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 3v4m10-4v4M4 9h16M5 5h14v16H5V5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <InputDate id="contacto-fecha" @bind-Value="contactoForm.FechaContacto" />
                </div>
            </div>

            <button class="message-submit" @onclick="GuardarContacto" disabled="@cargando">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                </svg>
                @(cargando ? "Guardando..." : modoEdicion ? "Guardar cambios" : "Agregar contacto")
            </button>

            @if (modoEdicion)
            {
                <button class="message-cancel" @onclick="CancelarEdicion">Cancelar edicion</button>
            }

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="message-alert error">@mensajeError</div>
            }
        </aside>

        <section class="message-main-card ui-reveal" style="--reveal-delay: 80ms;">
            <div class="message-toolbar">
                <label class="message-search">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m21 21-4.2-4.2M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <input placeholder="Buscar numero..."
                           @bind="busquedaNumero"
                           @bind:event="oninput"
                           @bind:after="ResetearPagina" />
                </label>

                <button class="message-send" @onclick="EnviarMensajes" disabled="@cargando">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m22 2-7 20-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                    @(cargando ? "Enviando..." : "Enviar mensaje")
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeEnvio))
            {
                <div class="message-alert ok">@mensajeEnvio</div>
            }

            <div class="message-summary-grid">
                <article class="message-summary blue">
                    <span class="summary-icon">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="2" />
                            <path d="M3.8 19c.45-3.3 2.25-5 5.2-5s4.75 1.7 5.2 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="2" />
                        </svg>
                    </span>
                    <div>
                        <span>Contactos visibles</span>
                        <strong>@contactosFiltrados.Count</strong>
                        <p>Contactos en el sistema</p>
                    </div>
                </article>

                <article class="message-summary amber">
                    <span class="summary-icon">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                            <path d="M12 7v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </span>
                    <div>
                        <span>Pendientes</span>
                        <strong>@PendientesVisibles</strong>
                        <p>Pendientes de envio</p>
                    </div>
                </article>

                <article class="message-summary green">
                    <span class="summary-icon">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="m22 2-7 20-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <div>
                        <span>Enviados este ciclo</span>
                        <strong>@EnviadosVisibles</strong>
                        <p>@PorcentajeEnviados()% del total de contactos</p>
                    </div>
                </article>
            </div>

            <div class="message-table-wrap">
                @if (cargando)
                {
                    <div class="message-state"><div class="spinner"></div><span>Cargando contactos...</span></div>
                }
                else if (!contactosFiltrados.Any())
                {
                    <div class="message-state"><span>No se encontraron contactos.</span></div>
                }
                else
                {
                    <table class="message-table">
                        <thead>
                            <tr>
                                <th>Numero</th>
                                <th>Fecha de contacto</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contacto in contactosPagina)
                            {
                                <tr class="@(contactoSeleccionado?.Id == contacto.Id ? "selected-row" : "")" @key="contacto.Id">
                                    <td>@contacto.Numero</td>
                                    <td>@contacto.FechaContacto.ToString("dd/MM/yyyy")</td>
                                    <td><span class="status-badge @GetEstadoClass(contacto.Estado)">@NormalizarEstado(contacto.Estado)</span></td>
                                    <td>
                                        <div class="message-row-actions">
                                            <button class="row-action edit" @onclick="() => EditarContacto(contacto)">
                                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                                                </svg>
                                                Editar
                                            </button>
                                            <button class="row-action delete" @onclick="() => EliminarContacto(contacto.Numero)">
                                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                                Borrar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (contactosFiltrados.Any())
            {
                <footer class="message-pagination">
                    <span>Mostrando @PrimerRegistro a @UltimoRegistro de @contactosFiltrados.Count contactos</span>
                    <div class="pager">
                        <button @onclick="PaginaAnterior" disabled="@(paginaActual <= 1)">&#8249;</button>
                        @foreach (var pagina in PaginasVisibles())
                        {
                            if (pagina is null)
                            {
                                <span class="pager-ellipsis">...</span>
                            }
                            else
                            {
                                <button class="@(pagina == PaginaNormalizada ? "active" : "")" @onclick="() => IrAPagina(pagina.Value)">@pagina</button>
                            }
                        }
                        <button @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas)">&#8250;</button>
                    </div>
                    <label class="page-size">
                        <span>Filas por pagina</span>
                        <select @bind="cantidadPorPagina" @bind:after="ResetearPagina">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </label>
                </footer>
            }
        </section>

        <aside class="message-side-card config-card ui-reveal" style="--reveal-delay: 160ms;">
            <header class="message-card-header">
                <h1>Configuracion</h1>
                <p>Parametros generales del recordatorio automatico</p>
            </header>

            <div class="config-state">
                <div>
                    <span>Frecuencia actual</span>
                    <strong>cada @configuracion.DiasRecordatorio dia(s)</strong>
                </div>
                <div>
                    <span>Repeticion</span>
                    <strong>@(configuracion.ReenviarAutomaticamente ? "Si" : "No")</strong>
                </div>
            </div>

            <div class="message-field">
                <label for="dias-recordatorio">Enviar recordatorio cada</label>
                <div class="message-input-shell">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 3v4m10-4v4M4 9h16M5 5h14v16H5V5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <input id="dias-recordatorio" type="number" min="1" @bind="configuracion.DiasRecordatorio" />
                </div>
            </div>

            <label class="message-check">
                <input type="checkbox" @bind="configuracion.ReenviarAutomaticamente" />
                <span>Enviar repetidamente</span>
            </label>

            <button class="message-submit" @onclick="GuardarConfiguracion" disabled="@cargando">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 4h12l2 2v14H5V4Zm3 0v6h8V4M8 20v-6h8v6" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
                Guardar
            </button>

            @if (!string.IsNullOrEmpty(mensajeConfig))
            {
                <div class="message-alert ok">@mensajeConfig</div>
            }
        </aside>
    </div>
</div>

@code {
    private List<ContactoMensajeDto> contactos = new();
    private ContactoMensajeDto contactoForm = new();
    private ContactoMensajeDto? contactoSeleccionado;
    private bool modoEdicion;
    private string? numeroOriginalEdicion;
    private string busquedaNumero = string.Empty;
    private bool cargando;
    private string mensajeError = string.Empty;
    private string mensajeEnvio = string.Empty;
    private string mensajeConfig = string.Empty;
    private ConfiguracionMensajesDto configuracion = new();
    private int paginaActual = 1;
    private int cantidadPorPagina = 10;

    private List<ContactoMensajeDto> contactosFiltrados => contactos
        .Where(c => string.IsNullOrWhiteSpace(busquedaNumero) || c.Numero.Contains(busquedaNumero, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(c => c.Estado == "Pendiente")
        .ThenBy(c => c.FechaContacto)
        .ToList();

    private int PendientesVisibles => contactosFiltrados.Count(x => NormalizarEstado(x.Estado) == "Pendiente");
    private int EnviadosVisibles => contactosFiltrados.Count(x => x.MensajeEnviado || NormalizarEstado(x.Estado) == "Contactado");
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(contactosFiltrados.Count / (double)cantidadPorPagina));
    private int PaginaNormalizada => Math.Min(Math.Max(1, paginaActual), totalPaginas);
    private List<ContactoMensajeDto> contactosPagina => contactosFiltrados
        .Skip((PaginaNormalizada - 1) * cantidadPorPagina)
        .Take(cantidadPorPagina)
        .ToList();
    private int PrimerRegistro => contactosFiltrados.Count == 0 ? 0 : ((PaginaNormalizada - 1) * cantidadPorPagina) + 1;
    private int UltimoRegistro => Math.Min(contactosFiltrados.Count, PaginaNormalizada * cantidadPorPagina);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await CargarInicialAsync();
        StateHasChanged();
    }

    private async Task CargarInicialAsync()
    {
        cargando = true;
        try
        {
            contactos = await MensajeService.GetContactosAsync();
            configuracion = await MensajeService.GetConfiguracionAsync();
        }
        catch
        {
            mensajeError = "Error al cargar los datos.";
        }
        finally
        {
            cargando = false;
            LimpiarFormulario();
        }
    }

    private async Task GuardarContacto()
    {
        if (string.IsNullOrWhiteSpace(contactoForm.Numero) || string.IsNullOrWhiteSpace(contactoForm.Estado))
        {
            mensajeError = "Completa numero y estado.";
            return;
        }

        mensajeError = string.Empty;
        cargando = true;

        try
        {
            var ok = modoEdicion && numeroOriginalEdicion is not null
                ? await MensajeService.EditarContactoAsync(numeroOriginalEdicion, contactoForm)
                : await MensajeService.AgregarContactoAsync(contactoForm);

            if (ok)
            {
                contactos = await MensajeService.GetContactosAsync();
                CancelarEdicion();
            }
            else
            {
                mensajeError = "No se pudo guardar el contacto.";
            }
        }
        catch
        {
            mensajeError = "Error al guardar el contacto.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void EditarContacto(ContactoMensajeDto contacto)
    {
        contactoSeleccionado = contacto;
        numeroOriginalEdicion = contacto.Numero;
        modoEdicion = true;
        mensajeError = string.Empty;

        contactoForm = new ContactoMensajeDto
        {
            Id = contacto.Id,
            Numero = contacto.Numero,
            Estado = NormalizarEstado(contacto.Estado),
            FechaContacto = contacto.FechaContacto,
            MensajeEnviado = contacto.MensajeEnviado
        };
    }

    private void CancelarEdicion()
    {
        modoEdicion = false;
        contactoSeleccionado = null;
        numeroOriginalEdicion = null;
        LimpiarFormulario();
    }

    private void LimpiarFormulario()
    {
        contactoForm = new ContactoMensajeDto
        {
            FechaContacto = DateTime.Today,
            Estado = "Pendiente"
        };
    }

    private async Task EliminarContacto(string numero)
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var ok = await MensajeService.EliminarContactoAsync(numero);

            if (ok)
            {
                contactos = await MensajeService.GetContactosAsync();
                if (contactoSeleccionado?.Numero == numero)
                {
                    CancelarEdicion();
                }
            }
            else
            {
                mensajeError = "No se pudo eliminar el contacto.";
            }
        }
        catch
        {
            mensajeError = "Error al eliminar el contacto.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarConfiguracion()
    {
        mensajeConfig = string.Empty;
        cargando = true;

        try
        {
            var ok = await MensajeService.GuardarConfiguracionAsync(configuracion);
            mensajeConfig = ok ? "Configuracion guardada." : "No se pudo guardar la configuracion.";
        }
        catch
        {
            mensajeConfig = "Error al guardar la configuracion.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EnviarMensajes()
    {
        mensajeEnvio = string.Empty;
        cargando = true;

        try
        {
            var ok = await MensajeService.EnviarMensajesPendientesAsync();
            mensajeEnvio = ok ? "Mensajes enviados correctamente." : "No se pudieron enviar los mensajes.";

            if (ok)
            {
                contactos = await MensajeService.GetContactosAsync();
            }
        }
        catch
        {
            mensajeEnvio = "Error al enviar los mensajes.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void ResetearPagina() => paginaActual = 1;

    private void PaginaAnterior() => paginaActual = Math.Max(1, PaginaNormalizada - 1);

    private void PaginaSiguiente() => paginaActual = Math.Min(totalPaginas, PaginaNormalizada + 1);

    private void IrAPagina(int pagina) => paginaActual = Math.Min(Math.Max(1, pagina), totalPaginas);

    private IEnumerable<int?> PaginasVisibles()
    {
        if (totalPaginas <= 5)
        {
            return Enumerable.Range(1, totalPaginas).Select<int, int?>(x => x);
        }

        var paginas = new List<int?> { 1 };
        var inicio = Math.Max(2, PaginaNormalizada - 1);
        var fin = Math.Min(totalPaginas - 1, PaginaNormalizada + 1);

        if (inicio > 2)
        {
            paginas.Add(null);
        }

        for (var pagina = inicio; pagina <= fin; pagina++)
        {
            paginas.Add(pagina);
        }

        if (fin < totalPaginas - 1)
        {
            paginas.Add(null);
        }

        paginas.Add(totalPaginas);
        return paginas;
    }

    private int PorcentajeEnviados() =>
        contactosFiltrados.Count == 0 ? 0 : (int)Math.Round(EnviadosVisibles / (double)contactosFiltrados.Count * 100);

    private static string NormalizarEstado(string? estado)
    {
        var limpio = estado?.Trim() ?? string.Empty;
        return limpio switch
        {
            "Asistió" => "Asistio",
            "No asistió" => "No asistio",
            _ => limpio
        };
    }

    private string GetEstadoClass(string estado) => NormalizarEstado(estado) switch
    {
        "Pendiente" => "pending",
        "Contactado" => "contacted",
        "Asistio" => "attended",
        "No asistio" => "missed",
        _ => "pending"
    };
}
